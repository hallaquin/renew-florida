# Copia este archivo a ".env" y completa los valores reales.
# NUNCA subas el archivo ".env" real al repositorio.

# Clave para firmar la sesión de Flask (login del admin). Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Clave de cifrado simétrico para el SSN. Genera una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Ruta de la base de datos. Por defecto usa SQLite en backend/data/renew_florida.db
# DATABASE_URL=sqlite:////ruta/absoluta/renew_florida.db

# Dominio del sitio de Renew Florida que puede llamar a la API (CORS).
# En desarrollo local puedes dejarlo en "*"; en producción usa el dominio real, p. ej.:
#   CORS_ALLOWED_ORIGIN=https://renew-florida.vercel.app
CORS_ALLOWED_ORIGIN=*
